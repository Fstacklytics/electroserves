###############################################################################
# ElectroServes — environment configuration
#
# Every variable listed under "Required" is validated at boot by
# App\Providers\EnvironmentValidationServiceProvider. The application refuses to
# serve traffic if any of them is missing, so misconfiguration surfaces
# immediately instead of when a visitor submits the contact form.
#
# Copy this file to .env and fill in the values, then run:
#   php artisan key:generate
###############################################################################

# --- Required: application -------------------------------------------------
APP_NAME=ElectroServes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Africa/Dar_es_Salaam

# --- Required: mail --------------------------------------------------------
# MAIL_MAILER=log writes messages to storage/logs instead of sending them,
# which is the right setting for local development.
# When MAIL_MAILER=smtp, MAIL_HOST and MAIL_PORT also become required.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@electroserves.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

# --- Required: contact form ------------------------------------------------
# Where contact form submissions are delivered.
CONTACT_NOTIFICATION_EMAIL=hello@electroserves.co.tz

# --- Optional: contact form abuse controls ---------------------------------
# Defaults implement the threat model requirement of 5 submissions per IP/hour.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_DECAY=3600

# --- Optional: content ------------------------------------------------------
# Absolute path to the content directory. Defaults to <project>/content.
# CONTENT_PATH=
# Disable while authoring content so edits appear immediately.
CONTENT_CACHE_ENABLED=true
CONTENT_CACHE_TTL=300

# --- Optional: framework ----------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
VITE_APP_NAME="${APP_NAME}"
