---
import { t } from '../../lib/i18n';
import { siteSettings } from '../../lib/content';
import MobileMenu, { type NavLink } from './MobileMenu.astro';

interface Props {
    pathname?: string;
}

const { pathname = '/' } = Astro.props;
const settings = siteSettings();
const emergencyHref = settings.emergencyPhoneHref();

const isActive = (pattern: string): boolean => {
    if (pattern === '/') return pathname === '/';
    return pathname.startsWith(pattern);
};

const links: NavLink[] = [
    { label: t('common.nav.home'), href: '/', active: isActive('/') },
    { label: t('common.nav.services'), href: '/services', active: isActive('/services') },
    { label: t('common.nav.projects'), href: '/projects', active: isActive('/projects') },
    { label: t('common.nav.about'), href: '/about', active: isActive('/about') },
    { label: t('common.nav.blog'), href: '/blog', active: isActive('/blog') },
    { label: t('common.nav.faq'), href: '/faq', active: isActive('/faq') },
    { label: t('common.nav.contact'), href: '/contact', active: isActive('/contact') },
];

const homeActive = isActive('/');
const logo = settings.logo;
---
<header
    x-data="{
        scrolled: false,
        mobileOpen: false,
        toggleMobileMenu() {
            if (!this.mobileOpen) {
                // A hard reset (init/pageshow/pagehide) may have forced an
                // inline display:none onto the menu; remove it so the enter
                // transition is not suppressed.
                const menu = document.getElementById('mobile-menu');
                if (menu) menu.style.removeProperty('display');
            }
            this.mobileOpen = !this.mobileOpen;
        },
        closeMobileMenu() {
            const wasOpen = this.mobileOpen;
            this.mobileOpen = false;
            this.releaseScrollLock();
            // Return focus to the toggle button when the menu closes via
            // Escape / resize / orientationchange / link-click / bfcache.
            // x-trap.noscroll already tries to restore focus, but an explicit
            // fallback covers the cases where focus is still inside the panel
            // or the trap was interrupted by navigation.
            if (wasOpen) {
                this.$nextTick(() => {
                    const btn = this.$refs.mobileToggle;
                    if (btn && document.activeElement !== btn) {
                        const activeInsideMenu = document.getElementById('mobile-menu')?.contains(document.activeElement);
                        if (activeInsideMenu || document.activeElement === document.body) {
                            btn.focus();
                        }
                    }
                });
            }
        },
        releaseScrollLock() {
            // x-trap.noscroll (@alpinejs/focus) locks <html> and compensates
            // the scrollbar with paddingRight. Clear body too, so no stale
            // lock can survive navigation, bfcache restore, or an Alpine
            // hiccup.
            document.documentElement.style.overflow = '';
            document.documentElement.style.paddingRight = '';
            document.body.style.overflow = '';
        },
        resetMobileMenu() {
            this.closeMobileMenu();
            // Belt-and-braces: force the menu shut even if Alpine's reactive
            // effects do not run (e.g. bfcache restore before effects flush,
            // or a partially initialised component).
            const menu = document.getElementById('mobile-menu');
            if (menu) {
                menu.style.display = 'none';
                menu.classList.remove('opacity-0', '-translate-y-2', 'opacity-100', 'translate-y-0');
            }
            this.releaseScrollLock();
        },
        closeOnLargeScreen() {
            // Tailwind's lg breakpoint is 1024px.
            if (window.innerWidth >= 1024) this.closeMobileMenu();
        },
        closeOnOrientationChange() {
            // iOS reports stale innerWidth during orientationchange, so close
            // unconditionally instead of checking the breakpoint.
            this.closeMobileMenu();
        },
        init() {
            // Alpine can be restored with the DOM by the browser's bfcache.
            // Never carry the old menu/scroll-lock state into a page view.
            this.resetMobileMenu();
        },
    }"
    x-on:scroll.window="scrolled = window.scrollY > 8"
    x-on:keydown.escape.window="closeMobileMenu()"
    x-on:resize.window="closeOnLargeScreen()"
    x-on:orientationchange.window="closeOnOrientationChange()"
    x-on:pagehide.window="resetMobileMenu()"
    x-on:pageshow.window="resetMobileMenu()"
    class="sticky top-0 z-50 bg-white transition-shadow duration-200"
    :class="scrolled ? 'shadow-md' : 'shadow-sm'"
>
    {
        emergencyHref && (
            <div class="bg-primary-900 text-white">
                <div class="container-page flex items-center justify-center gap-2 py-1.5 text-center text-xs sm:text-sm">
                    <svg class="h-4 w-4 shrink-0 text-secondary-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M11.983 1.907a.75.75 0 0 0-1.292-.657l-6.5 8.5A.75.75 0 0 0 4.75 11h3.925l-.658 5.093a.75.75 0 0 0 1.292.657l6.5-8.5A.75.75 0 0 0 15.25 7h-3.925l.658-5.093Z" />
                    </svg>
                    <span>{t('home.emergency.body')}</span>
                    <a
                        href={emergencyHref}
                        class="font-semibold underline underline-offset-2 hover:text-secondary-200 focus-visible:ring-offset-primary-900"
                    >{settings.emergencyPhone}</a>
                </div>
            </div>
        )
    }

    <nav class="container-page" aria-label={t('common.nav.label')}>
        <div class="flex min-h-[4.5rem] items-center justify-between gap-2 py-2.5 sm:gap-4 sm:py-3">
            <a
                href="/"
                class="flex min-w-0 shrink items-center gap-2 rounded-md py-1 text-base font-bold text-neutral-900 hover:text-primary-800 sm:gap-2.5 sm:text-lg"
                aria-current={homeActive ? 'page' : undefined}
            >
                {
                    logo ? (
                        <img src={logo} alt={settings.siteName} width="40" height="40" class="h-10 w-auto" loading="eager" decoding="async" />
                    ) : (
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary-800 sm:h-10 sm:w-10" aria-hidden="true">
                            <svg class="h-6 w-6 text-secondary-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                                <path d="M13.2 2 6 12h4.5l-1.2 10L18 10h-5.2z" />
                            </svg>
                        </span>
                    )
                }
                <span class="whitespace-nowrap">{settings.siteName}</span>
            </a>

            <ul class="hidden items-center gap-1 lg:flex">
                {
                    links.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class:list={[
                                    'relative flex min-h-touch items-center rounded-md px-3 text-sm font-medium transition-colors',
                                    link.active
                                        ? 'text-primary-800 bg-primary-50'
                                        : 'text-neutral-700 hover:bg-neutral-100 hover:text-neutral-900',
                                ]}
                                aria-current={link.active ? 'page' : undefined}
                            >{link.label}</a>
                        </li>
                    ))
                }
            </ul>

            <div class="flex items-center gap-2">
                <a
                    href="/contact"
                    class="hidden min-h-touch items-center justify-center gap-2 rounded-md bg-primary-800 px-3.5 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-900 active:bg-primary-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2 sm:inline-flex"
                >
                    {t('common.cta.get_quote')}
                </a>

                <button
                    type="button"
                    x-cloak
                    x-ref="mobileToggle"
                    x-on:click="toggleMobileMenu()"
                    :aria-expanded="mobileOpen ? 'true' : 'false'"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                    class="touch-target rounded-md text-neutral-700 hover:bg-neutral-100 hover:text-neutral-900 lg:hidden"
                >
                    <span class="sr-only" x-text="mobileOpen ? 'Close main menu' : 'Open main menu'">{t('common.nav.open_menu')}</span>
                    <!-- Triple-layered exclusivity: x-cloak (pre-init) + x-show (Alpine state) + :class hidden (redundant guard) -->
                    <svg x-show="! mobileOpen" x-cloak :class="{ 'hidden': mobileOpen }" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true" focusable="false">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                    <svg x-show="mobileOpen" x-cloak :class="{ 'hidden': ! mobileOpen }" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true" focusable="false">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>

        <MobileMenu links={links} />
    </nav>
</header>
