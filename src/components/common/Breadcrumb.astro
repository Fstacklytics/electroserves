---
import { t } from '../../lib/i18n';

export interface Crumb {
    label: string;
    url?: string;
}

interface Props {
    crumbs?: Crumb[];
}

const { crumbs = [] } = Astro.props;
---
{
    crumbs.length > 0 && (
        <nav aria-label={t('common.breadcrumb.label')} class="pt-4">
            <ol class="flex flex-wrap items-center gap-1 text-sm">
                {
                    crumbs.map((crumb, i) => (
                        <li class="flex items-center gap-1">
                            {i > 0 && (
                                <svg class="h-4 w-4 text-neutral-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd" />
                                </svg>
                            )}
                            {
                                crumb.url && i < crumbs.length - 1 ? (
                                    <a href={crumb.url} class="rounded py-1 text-neutral-600 transition-colors hover:text-primary-800 hover:underline">{crumb.label}</a>
                                ) : (
                                    <span class="py-1 font-medium text-neutral-700" aria-current="page">{crumb.label}</span>
                                )
                            }
                        </li>
                    ))
                }
            </ol>
        </nav>
    )
}
