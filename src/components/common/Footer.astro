---
import { t } from '../../lib/i18n';
import { siteSettings, services } from '../../lib/content';
import Social from '../icons/Social.astro';

const settings = siteSettings();
const footerServices = services().slice(0, 5);
const currentYear = new Date().getFullYear();

const quickLinks = [
    { href: '/services', label: t('common.nav.services') },
    { href: '/projects', label: t('common.nav.projects') },
    { href: '/about', label: t('common.nav.about') },
    { href: '/blog', label: t('common.nav.blog') },
    { href: '/testimonials', label: t('common.nav.testimonials') },
    { href: '/faq', label: t('common.nav.faq') },
    { href: '/contact', label: t('common.nav.contact') },
];

const socialLabels: Record<string, string> = {
    facebook: t('common.social.facebook'),
    instagram: t('common.social.instagram'),
    twitter: t('common.social.twitter'),
    linkedin: t('common.social.linkedin'),
    youtube: t('common.social.youtube'),
    whatsapp: t('common.social.whatsapp'),
};

const socialEntries = Object.entries(settings.socialLinks);
const phoneHref = settings.phoneHref();
const emergencyHref = settings.emergencyPhoneHref();
const address = settings.fullAddress();
---
<footer class="mt-auto bg-neutral-900 text-neutral-300">
    <div class="container-page py-12 lg:py-16">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
            <div>
                <p class="text-lg font-bold text-white">{settings.siteName}</p>
                {
                    settings.tagline && (
                        <p class="mt-2 max-w-xs text-sm leading-relaxed text-neutral-400">{settings.tagline}</p>
                    )
                }

                {
                    settings.hasSocialLinks() && (
                        <div class="mt-5">
                            <p class="text-sm font-semibold text-white">{t('common.footer.follow_us')}</p>
                            <ul class="mt-3 flex flex-wrap gap-2">
                                {
                                    socialEntries.map(([network, url]) => (
                                        <li>
                                            <a
                                                href={url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="touch-target rounded-md bg-neutral-800 text-neutral-300 transition-colors hover:bg-primary-700 hover:text-white focus-visible:ring-offset-neutral-900"
                                            >
                                                <span class="sr-only">{socialLabels[network] ?? network}</span>
                                                <Social network={network} class="h-5 w-5" />
                                            </a>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    )
                }
            </div>

            <nav aria-labelledby="footer-quick-links">
                <p id="footer-quick-links" class="text-sm font-semibold text-white">{t('common.footer.quick_links')}</p>
                <ul class="mt-4 space-y-1">
                    {
                        quickLinks.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class="flex min-h-touch items-center text-sm text-neutral-400 transition-colors hover:text-white focus-visible:ring-offset-neutral-900"
                                >{link.label}</a>
                            </li>
                        ))
                    }
                </ul>
            </nav>

            <nav aria-labelledby="footer-services">
                <p id="footer-services" class="text-sm font-semibold text-white">{t('common.footer.our_services')}</p>
                {
                    footerServices.length === 0 ? (
                        <p class="mt-4 text-sm text-neutral-500">{t('home.services.empty')}</p>
                    ) : (
                        <ul class="mt-4 space-y-1">
                            {
                                footerServices.map((service) => (
                                    <li>
                                        <a
                                            href={`/services/${service.slug}`}
                                            class="flex min-h-touch items-center text-sm text-neutral-400 transition-colors hover:text-white focus-visible:ring-offset-neutral-900"
                                        >{service.title}</a>
                                    </li>
                                ))
                            }
                        </ul>
                    )
                }
            </nav>

            <div>
                <p class="text-sm font-semibold text-white">{t('common.footer.get_in_touch')}</p>
                <ul class="mt-4 space-y-3 text-sm">
                    {
                        phoneHref && (
                            <li class="flex items-start gap-2.5">
                                <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                    <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.5 11.5 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-7.18 0-13-5.82-13-13V3.5Z" />
                                </svg>
                                <span>
                                    <span class="sr-only">{t('common.meta.phone')}:</span>
                                    <a href={phoneHref} class="text-neutral-300 hover:text-white focus-visible:ring-offset-neutral-900">{settings.phone}</a>
                                </span>
                            </li>
                        )
                    }
                    {
                        emergencyHref && (
                            <li class="flex items-start gap-2.5">
                                <svg class="mt-0.5 h-5 w-5 shrink-0 text-secondary-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                    <path d="M11.983 1.907a.75.75 0 0 0-1.292-.657l-6.5 8.5A.75.75 0 0 0 4.75 11h3.925l-.658 5.093a.75.75 0 0 0 1.292.657l6.5-8.5A.75.75 0 0 0 15.25 7h-3.925l.658-5.093Z" />
                                </svg>
                                <span>
                                    <span class="sr-only">{t('common.footer.emergency_line')}:</span>
                                    <a href={emergencyHref} class="text-neutral-300 hover:text-white focus-visible:ring-offset-neutral-900">{settings.emergencyPhone}</a>
                                </span>
                            </li>
                        )
                    }
                    {
                        settings.email && (
                            <li class="flex items-start gap-2.5">
                                <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                    <path d="M3 4a2 2 0 0 0-2 2v.161l8.441 4.221a1.25 1.25 0 0 0 1.118 0L19 6.161V6a2 2 0 0 0-2-2H3Z" />
                                    <path d="m19 8.839-7.77 3.885a2.75 2.75 0 0 1-2.46 0L1 8.839V14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.839Z" />
                                </svg>
                                <span>
                                    <span class="sr-only">{t('common.meta.email')}:</span>
                                    <a href={`mailto:${settings.email}`} class="break-all text-neutral-300 hover:text-white focus-visible:ring-offset-neutral-900">{settings.email}</a>
                                </span>
                            </li>
                        )
                    }
                    {
                        address && (
                            <li class="flex items-start gap-2.5">
                                <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                    <path fill-rule="evenodd" d="M9.69 18.933A7.5 7.5 0 0 0 10 19a7.5 7.5 0 0 0 .31-.067C13.02 17.79 16 14.2 16 10a6 6 0 1 0-12 0c0 4.2 2.98 7.79 5.69 8.933ZM10 11.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z" clip-rule="evenodd" />
                                </svg>
                                <address class="not-italic text-neutral-400">
                                    <span class="sr-only">{t('common.meta.address')}:</span>
                                    {address}
                                </address>
                            </li>
                        )
                    }
                </ul>

                {
                    settings.hasBusinessHours() && (
                        <div class="mt-5">
                            <p class="text-sm font-semibold text-white">{t('common.footer.business_hours')}</p>
                            <dl class="mt-2 space-y-1 text-sm text-neutral-400">
                                {
                                    settings.businessHours.map((row) => (
                                        <div class="flex justify-between gap-3">
                                            <dt>{row.day}</dt>
                                            <dd class="text-right">{row.hours}</dd>
                                        </div>
                                    ))
                                }
                            </dl>
                        </div>
                    )
                }
            </div>
        </div>

        <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-neutral-800 pt-6 sm:flex-row">
            <p class="text-center text-xs text-neutral-500 sm:text-left">
                &copy; {currentYear} {settings.copyright || settings.siteName}. {t('common.footer.built_with')}
            </p>

            <div class="flex items-center gap-4">
                <a href="/privacy-policy" class="text-xs text-neutral-500 hover:text-white focus-visible:ring-offset-neutral-900">{t('legal.privacy_title')}</a>
                <a href="/terms" class="text-xs text-neutral-500 hover:text-white focus-visible:ring-offset-neutral-900">{t('legal.terms_title')}</a>
                <a
                    href="#main-content"
                    class="flex min-h-touch items-center gap-1 text-xs text-neutral-500 hover:text-white focus-visible:ring-offset-neutral-900"
                >
                    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                        <path fill-rule="evenodd" d="M10 17a.75.75 0 0 1-.75-.75V5.612L5.29 9.77a.75.75 0 0 1-1.08-1.04l5.25-5.5a.75.75 0 0 1 1.08 0l5.25 5.5a.75.75 0 1 1-1.08 1.04l-3.96-4.158V16.25A.75.75 0 0 1 10 17Z" clip-rule="evenodd" />
                    </svg>
                    {t('common.cta.back_to_top')}
                </a>
            </div>
        </div>
    </div>
</footer>
