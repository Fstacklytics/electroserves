---
interface Props {
    name?: string;
    class?: string;
}

const { name = 'bolt' } = Astro.props;
const cls = Astro.props.class ?? '';

const groups: Record<string, string[]> = {
    home: ['home', 'house'],
    building: ['building', 'office'],
    cpu: ['cpu', 'chip', 'electronics'],
    wrench: ['wrench', 'tools', 'installation'],
    shield: ['shield', 'safety'],
    lightbulb: ['lightbulb', 'light'],
    battery: ['battery', 'solar'],
    bolt: ['bolt', 'default'],
};

const iconName = Object.keys(groups).find((key) => groups[key].includes(name)) ?? 'bolt';
const shared = {
    class: cls,
    fill: 'none',
    viewBox: '0 0 24 24',
    'stroke-width': '1.5',
    stroke: 'currentColor',
    'aria-hidden': 'true',
    focusable: 'false',
};
