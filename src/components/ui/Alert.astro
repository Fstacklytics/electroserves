---
import { t } from '../../lib/i18n';

interface Props {
    type?: 'success' | 'warning' | 'error' | 'info';
    title?: string;
    dismissible?: boolean;
    class?: string;
}

const { type = 'info', title, dismissible = false, class: className = '' } = Astro.props;

const styles: Record<string, { wrapper: string; icon: string; role: string }> = {
    success: { wrapper: 'bg-success-50 border-success-500 text-success-800', icon: 'text-success-600', role: 'status' },
    warning: { wrapper: 'bg-warning-50 border-warning-500 text-warning-800', icon: 'text-warning-600', role: 'alert' },
    error: { wrapper: 'bg-danger-50 border-danger-500 text-danger-800', icon: 'text-danger-600', role: 'alert' },
    info: { wrapper: 'bg-info-50 border-info-500 text-info-800', icon: 'text-info-600', role: 'status' },
};

const style = styles[type] ?? styles.info;
---
<div
    {...(dismissible ? { 'x-data': '{ shown: true }', 'x-show': 'shown', 'x-cloak': true } : {})}
    role={style.role}
    class:list={['flex items-start gap-3 rounded-md border-l-4 p-4', style.wrapper, className]}
>
    <span class:list={['mt-0.5 shrink-0', style.icon]} aria-hidden="true">
        {
            type === 'success' ? (
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" focusable="false">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                </svg>
            ) : type === 'error' ? (
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" focusable="false">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
                </svg>
            ) : type === 'warning' ? (
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" focusable="false">
                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.19-1.458-1.517-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
                </svg>
            ) : (
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" focusable="false">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd" />
                </svg>
            )
        }
    </span>

    <div class="min-w-0 flex-1 text-sm">
        {title && <p class="font-semibold">{title}</p>}
        <div class:list={[title && 'mt-1']}><slot /></div>
    </div>

    {
        dismissible && (
            <button type="button" x-on:click="shown = false" class="touch-target -m-2 shrink-0 rounded-md hover:bg-black/5">
                <span class="sr-only">Dismiss</span>
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
                </svg>
            </button>
        )
    }
</div>
