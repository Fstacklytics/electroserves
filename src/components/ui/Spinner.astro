---
import { t } from '../../lib/i18n';

interface Props {
    size?: 'sm' | 'md' | 'lg';
    label?: boolean;
    text?: string;
    class?: string;
}

const { size = 'md', label = true, text, class: className = '' } = Astro.props;

const sizes: Record<string, string> = {
    sm: 'h-4 w-4 border-2',
    md: 'h-6 w-6 border-2',
    lg: 'h-10 w-10 border-[3px]',
};

const classes = `${sizes[size] ?? sizes.md} inline-block animate-spin rounded-full border-current border-r-transparent align-[-0.125em]`;
---
{
    label ? (
        <span class:list={['inline-flex items-center gap-2', className]} role="status">
            <span class={classes} aria-hidden="true"></span>
            <span class="sr-only">{text ?? t('common.states.loading')}</span>
            {text && <span aria-hidden="true">{text}</span>}
        </span>
    ) : (
        <span class:list={[classes, className]} aria-hidden="true"></span>
    )
}
