---
interface Props {
    src?: string;
    alt?: string;
    width?: number;
    height?: number;
    eager?: boolean;
    label?: string;
    rounded?: string;
    class?: string;
    /**
     * When there is no `src`, do not invent a photo-sized empty frame.
     * Pass `placeholder` only for compact spots that still need a box
     * (avatars already use initials instead).
     */
    placeholder?: boolean;
    [key: string]: any;
}

const {
    src,
    alt = '',
    width = 800,
    height = 600,
    eager = false,
    label,
    rounded = '',
    class: className = '',
    placeholder = false,
    children,
    ...rest
} = Astro.props;

const hasImage = Boolean(src && src.trim() !== '');
const boxClasses = `${className} ${rounded}`.trim();
const classHasOwnBox = /\b(h-\S+|aspect-\S+|absolute|inset-0)\b/.test(className);
const placeholderClass = boxClasses
    .split(/\s+/)
    .filter((token) => token && !/^(object-|group-hover:scale)/.test(token))
    .join(' ');
---
{
    hasImage ? (
        <img
            src={src}
            alt={alt}
            width={width}
            height={height}
            loading={eager ? 'eager' : 'lazy'}
            fetchpriority={eager ? 'high' : undefined}
            decoding="async"
            class={boxClasses}
            {...rest}
        />
    ) : placeholder ? (
        <div
            class:list={['image-placeholder', placeholderClass]}
            style={classHasOwnBox ? undefined : `aspect-ratio: ${width} / ${height};`}
            role={label ? 'img' : undefined}
            aria-label={label || undefined}
            aria-hidden={label ? undefined : 'true'}
            {...rest}
        >
            <svg class="h-8 w-8 text-primary-700 opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 6.75h.008v.008H3.75V6.75Zm16.5 0A2.25 2.25 0 0 0 18 4.5H6A2.25 2.25 0 0 0 3.75 6.75v10.5A2.25 2.25 0 0 0 6 19.5h12a2.25 2.25 0 0 0 2.25-2.25V6.75Z" />
            </svg>
        </div>
    ) : null
}
