---
import { t } from '../../lib/i18n';

interface Props {
    variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'danger' | 'white';
    size?: 'sm' | 'md' | 'lg';
    type?: 'button' | 'submit' | 'reset';
    href?: string;
    loading?: boolean;
    disabled?: boolean;
    loadingText?: string;
    icon?: boolean;
    class?: string;
    [key: string]: any;
}

const {
    variant = 'primary',
    size = 'md',
    type = 'button',
    href,
    loading = false,
    disabled = false,
    loadingText,
    icon = false,
    class: className = '',
    children,
    ...rest
} = Astro.props;

const isInteractiveLink = href !== null && href !== undefined && !disabled && !loading;
const tag = isInteractiveLink ? 'a' : 'button';
const isBlocked = disabled || loading;

const base =
    'relative inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-150 select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2';

const variants: Record<string, string> = {
    primary: 'bg-primary-800 text-white shadow-sm hover:bg-primary-900 active:bg-primary-950 focus-visible:ring-primary-600',
    secondary: 'bg-secondary-500 text-neutral-900 shadow-sm hover:bg-secondary-400 active:bg-secondary-600 focus-visible:ring-secondary-600',
    outline: 'border-2 border-primary-800 bg-transparent text-primary-800 hover:bg-primary-50 active:bg-primary-100 focus-visible:ring-primary-600',
    ghost: 'bg-transparent text-primary-800 hover:bg-primary-50 active:bg-primary-100 focus-visible:ring-primary-600',
    danger: 'bg-danger-600 text-white shadow-sm hover:bg-danger-700 active:bg-danger-800 focus-visible:ring-danger-600',
    white: 'bg-white text-primary-900 shadow-sm hover:bg-neutral-100 active:bg-neutral-200 focus-visible:ring-white',
};

const sizes: Record<string, string> = {
    sm: 'min-h-touch px-3.5 py-2 text-sm',
    md: 'min-h-touch px-5 py-2.5 text-sm',
    lg: 'min-h-[3rem] px-6 py-3 text-base',
};

const classes = [base, variants[variant] ?? variants.primary, sizes[size] ?? sizes.md, isBlocked ? 'cursor-not-allowed opacity-60' : '', className].join(' ');
---

{
    isInteractiveLink ? (
        <a href={href} class={classes} {...rest}>
            {icon && <span class="shrink-0" aria-hidden="true"><slot name="icon" /></span>}
            <span><slot /></span>
        </a>
    ) : (
        <button
            type={type}
            disabled={disabled}
            aria-disabled:disabled || loading ? 'true' : undefined
            aria-busy={loading || undefined}
            class={classes}
            {...rest}
        >
            {
                loading ? (
                    <>
                        <span class="inline-block h-4 w-4 shrink-0 animate-spin rounded-full border-2 border-current border-r-transparent" aria-hidden="true"></span>
                        <span>{loadingText ?? t('common.states.loading')}</span>
                    </>
                ) : (
                    <>
                        {icon && <span class="shrink-0" aria-hidden="true"><slot name="icon" /></span>}
                        <span><slot /></span>
                    </>
                )
            }
        </button>
    )
}
