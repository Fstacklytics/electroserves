---
import { t } from '../../lib/i18n';
import type { BlogPost } from '../../lib/content';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Media from '../ui/Media.astro';

interface Props {
    post: BlogPost;
}

const { post } = Astro.props;
---
<Card as="article" hoverable padding="none" class="flex h-full flex-col" data-category={post.category}>
    <Media src={post.featuredImage} alt={post.title} width={640} height={360} class="h-44 w-full object-cover" />
    <div class="flex flex-1 flex-col p-5">
        <div class="flex flex-wrap items-center gap-2">
            <Badge variant="secondary">{post.category}</Badge>
            {post.date && (
                <time datetime={post.dateIso() ?? undefined} class="text-xs text-neutral-500">{post.formattedDate()}</time>
            )}
        </div>

        <h3 class="mt-2 text-lg font-semibold text-neutral-900">
            <a href={`/blog/${post.slug}`} class="after:absolute after:inset-0 focus-visible:outline-none">
                {post.title}
            </a>
        </h3>

        <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-600">{post.excerpt}</p>

        <p class="mt-4 text-xs text-neutral-500">
            {t('blog.show.by_author', { author: post.author })}
            <span aria-hidden="true">·</span>
            {t('blog.show.reading_time', { minutes: post.readingTimeMinutes() })}
        </p>
    </div>
</Card>
