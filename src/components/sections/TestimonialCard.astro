---
import { t } from '../../lib/i18n';
import type { Testimonial } from '../../lib/content';
import Card from '../ui/Card.astro';
import StarRating from '../ui/StarRating.astro';
import Media from '../ui/Media.astro';

interface Props {
    testimonial: Testimonial;
}

const { testimonial } = Astro.props;
const photoAlt = t('testimonials.photo_alt', { name: testimonial.clientName });
---
<Card as="figure" class="flex h-full flex-col" data-service={testimonial.serviceUsed || undefined}>
    <StarRating rating={testimonial.rating} label={testimonial.ratingLabel()} />
    <blockquote class="mt-3 flex-1">
        <p class="text-base leading-relaxed text-neutral-700">&ldquo;{testimonial.quote}&rdquo;</p>
    </blockquote>
    <figcaption class="mt-5 flex items-center gap-3 border-t border-neutral-200 pt-4">
        {
            testimonial.hasPhoto() ? (
                <Media src={testimonial.photo} alt={photoAlt} width={48} height={48} class="h-12 w-12 shrink-0 rounded-full object-cover" />
            ) : (
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary-100 text-sm font-semibold text-primary-800" aria-hidden="true">
                    {testimonial.initials()}
                </span>
            )
        }
        <div class="min-w-0">
            <p class="truncate text-sm font-semibold text-neutral-900">{testimonial.clientName}</p>
            {testimonial.company && <p class="truncate text-sm text-neutral-500">{testimonial.company}</p>}
        </div>
    </figcaption>
</Card>
