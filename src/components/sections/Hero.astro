---
import { t } from '../../lib/i18n';
import type { HeroSlide } from '../../lib/content';
import Media from '../ui/Media.astro';

interface Props {
    slides: HeroSlide[];
}

const { slides } = Astro.props;
const hasSlides = slides.length > 0;
const total = hasSlides ? slides.length : 1;
---
<section
    x-data={`carousel({ total: ${total}, interval: 7000, autoplay: ${total > 1 ? 'true' : 'false'} })`}
    x-on:mouseenter="onEnter()"
    x-on:mouseleave="onLeave()"
    x-on:focusin="onEnter()"
    x-on:focusout="onLeave()"
    x-on:keydown.arrow-right.prevent="manualNext()"
    x-on:keydown.arrow-left.prevent="manualPrevious()"
    class="relative isolate overflow-hidden bg-primary-900"
    role="region"
    aria-roledescription="carousel"
    aria-label={t('home.hero.label')}
>
    {
        !hasSlides ? (
            <div class="relative">
                <div class="absolute inset-0 bg-gradient-to-br from-primary-900 via-primary-800 to-primary-950" aria-hidden="true"></div>
                <div class="container-page relative py-20 sm:py-28">
                    <div class="max-w-2xl">
                        <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">{t('home.hero.empty_heading')}</h1>
                        <p class="mt-5 text-lg leading-relaxed text-primary-100">{t('home.hero.empty_subheading')}</p>
                        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                            <a href="/contact" class="inline-flex min-h-[3rem] items-center justify-center gap-2 rounded-md bg-secondary-500 px-6 py-3 text-base font-semibold text-neutral-900 shadow-sm transition-colors hover:bg-secondary-400 active:bg-secondary-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary-600 focus-visible:ring-offset-2">{t('common.cta.get_quote')}</a>
                            <a href="/services" class="inline-flex min-h-[3rem] items-center justify-center gap-2 rounded-md bg-white px-6 py-3 text-base font-semibold text-primary-900 shadow-sm transition-colors hover:bg-neutral-100 active:bg-neutral-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2">{t('home.cta.secondary')}</a>
                        </div>
                    </div>
                </div>
            </div>
        ) : (
            <>
                <div :aria-live="liveSetting">
                    {
                        slides.map((slide, index) => (
                            <div
                                x-show={`isActive(${index})`}
                                x-cloak={index > 0 ? true : undefined}
                                x-transition:enter="transition ease-out duration-500"
                                x-transition:enter-start="opacity-0"
                                x-transition:enter-end="opacity-100"
                                class:list={['relative', index > 0 && 'absolute inset-0']}
                                role="group"
                                aria-roledescription="slide"
                                aria-label={t('home.hero.slide_position', { current: index + 1, total })}
                            >
                                {
                                    slide.image ? (
                                        <>
                                            <Media src={slide.image} alt="" width={1920} height={900} eager={index === 0} class="absolute inset-0 h-full w-full object-cover" />
                                            <div class="absolute inset-0 bg-gradient-to-r from-primary-950/90 via-primary-900/80 to-primary-900/50" aria-hidden="true"></div>
                                        </>
                                    ) : (
                                        <div class="absolute inset-0 bg-gradient-to-br from-primary-900 via-primary-800 to-primary-950" aria-hidden="true"></div>
                                    )
                                }

                                <div class="container-page relative py-20 sm:py-28">
                                    <div class="max-w-2xl">
                                        {
                                            index === 0 ? (
                                                <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">{slide.heading}</h1>
                                            ) : (
                                                <p class="text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">{slide.heading}</p>
                                            )
                                        }

                                        {slide.subheading && <p class="mt-5 text-lg leading-relaxed text-primary-100">{slide.subheading}</p>}

                                        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                                            <a href={slide.ctaLink} class="inline-flex min-h-[3rem] items-center justify-center gap-2 rounded-md bg-secondary-500 px-6 py-3 text-base font-semibold text-neutral-900 shadow-sm transition-colors hover:bg-secondary-400 active:bg-secondary-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary-600 focus-visible:ring-offset-2">{slide.ctaText}</a>

                                            {
                                                slide.hasSecondaryCta() && (
                                                    <a href={slide.ctaSecondaryLink} class="inline-flex min-h-[3rem] items-center justify-center gap-2 rounded-md bg-white px-6 py-3 text-base font-semibold text-primary-900 shadow-sm transition-colors hover:bg-neutral-100 active:bg-neutral-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2">{slide.ctaSecondaryText}</a>
                                                )
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>

                {
                    total > 1 && (
                        <>
                            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-primary-950/85 to-transparent" aria-hidden="true"></div>
                            <div class="container-page relative z-10 flex items-center gap-2 pb-6 sm:gap-3">
                                <button type="button" x-on:click="manualPrevious()" class="touch-target rounded-full bg-white/15 text-white ring-1 ring-white/25 backdrop-blur transition-colors hover:bg-white/25 focus-visible:ring-white focus-visible:ring-offset-primary-900">
                                    <span class="sr-only">{t('home.hero.previous_slide')}</span>
                                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                        <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 0 1-.02 1.06L8.832 10l3.938 3.71a.75.75 0 1 1-1.04 1.08l-4.5-4.25a.75.75 0 0 1 0-1.08l4.5-4.25a.75.75 0 0 1 1.06.02Z" clip-rule="evenodd" />
                                    </svg>
                                </button>

                                <button type="button" x-on:click="manualNext()" class="touch-target rounded-full bg-white/15 text-white ring-1 ring-white/25 backdrop-blur transition-colors hover:bg-white/25 focus-visible:ring-white focus-visible:ring-offset-primary-900">
                                    <span class="sr-only">{t('home.hero.next_slide')}</span>
                                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd" />
                                    </svg>
                                </button>

                                <button type="button" x-on:click="toggle()" class="touch-target rounded-full bg-white/15 text-white ring-1 ring-white/25 backdrop-blur transition-colors hover:bg-white/25 focus-visible:ring-white focus-visible:ring-offset-primary-900">
                                    <span class="sr-only" x-text={`playing ? '${t('home.hero.pause')}' : '${t('home.hero.play')}'`}>{t('home.hero.pause')}</span>
                                    <svg x-show="playing" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                        <path d="M5.75 3a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 0 0 .75-.75V3.75A.75.75 0 0 0 7.25 3h-1.5Zm7 0a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 0 0 .75-.75V3.75a.75.75 0 0 0-.75-.75h-1.5Z" />
                                    </svg>
                                    <svg x-show="! playing" x-cloak class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                        <path d="M6.3 2.84A1.5 1.5 0 0 0 4 4.11v11.78a1.5 1.5 0 0 0 2.3 1.27l9.344-5.891a1.5 1.5 0 0 0 0-2.538L6.3 2.841Z" />
                                    </svg>
                                </button>

                                <div class="ml-auto flex items-center gap-2">
                                    {
                                        Array.from({ length: total }).map((_, i) => (
                                            <button type="button" x-on:click={`manualGo(${i})`} class="flex h-touch w-6 items-center justify-center focus-visible:ring-white focus-visible:ring-offset-primary-900">
                                                <span class="sr-only">{t('home.hero.go_to_slide', { number: i + 1 })}</span>
                                                <span class="block h-2 rounded-full transition-all duration-200" x-bind:class={`isActive(${i}) ? 'w-5 bg-secondary-400' : 'w-2 bg-white/40'`} aria-hidden="true"></span>
                                            </button>
                                        ))
                                    }
                                </div>
                            </div>
                        </>
                    )
                }
            </>
        )
    }
</section>
