---
interface Props {
    heading: string;
    body?: string;
    buttonLabel?: string;
    buttonHref?: string;
    secondaryLabel?: string;
    secondaryHref?: string;
    variant?: 'default' | 'emergency';
}

const { heading, body, buttonLabel, buttonHref, secondaryLabel, secondaryHref, variant = 'default' } = Astro.props;
const isEmergency = variant === 'emergency';
const showActions = (buttonLabel && buttonHref) || (secondaryLabel && secondaryHref);
---
<section class:list={[isEmergency ? 'bg-danger-700' : 'bg-primary-800']}>
    <div class="container-page py-12 sm:py-16">
        <div class="flex flex-col items-center gap-6 text-center lg:flex-row lg:justify-between lg:text-left">
            <div class="max-w-2xl">
                <h2 class="text-2xl font-bold text-white sm:text-3xl">{heading}</h2>
                {body && <p class:list={['mt-3 text-base leading-relaxed', isEmergency ? 'text-danger-100' : 'text-primary-100']}>{body}</p>}
            </div>

            {
                showActions && (
                    <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
                        {
                            buttonLabel && buttonHref && (
                                <a
                                    href={buttonHref}
                                    class:list={[
                                        'inline-flex min-h-[3rem] w-full items-center justify-center gap-2 rounded-md px-6 py-3 text-base font-semibold shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 sm:w-auto',
                                        isEmergency
                                            ? 'bg-white text-primary-900 hover:bg-neutral-100 active:bg-neutral-200 focus-visible:ring-white'
                                            : 'bg-secondary-500 text-neutral-900 hover:bg-secondary-400 active:bg-secondary-600 focus-visible:ring-secondary-600',
                                    ]}
                                >{buttonLabel}</a>
                            )
                        }
                        {
                            secondaryLabel && secondaryHref && (
                                <a
                                    href={secondaryHref}
                                    class:list={[
                                        'inline-flex min-h-touch w-full items-center justify-center rounded-md border-2 border-white/70 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-white/10 focus-visible:ring-white sm:w-auto',
                                        isEmergency ? 'focus-visible:ring-offset-danger-700' : 'focus-visible:ring-offset-primary-700',
                                    ]}
                                >{secondaryLabel}</a>
                            )
                        }
                    </div>
                )
            }
        </div>
    </div>
</section>
