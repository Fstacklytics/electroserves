---
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';
import { siteSettings, services } from '../lib/content';
import { resolveSeo, breadcrumbSchema } from '../lib/seo';
import PageHeader from '../components/sections/PageHeader.astro';
import Card from '../components/ui/Card.astro';

const url = Astro.url;
const settings = siteSettings();
const allServices = services();

const serviceTypes: Record<string, string> = {};
for (const service of allServices) {
    serviceTypes[service.slug] = service.title;
}
serviceTypes['other'] = t('contact.service_other');

const breadcrumbs = [
    { label: t('common.nav.home'), url: '/' },
    { label: t('contact.title') },
];

const schema = breadcrumbSchema([
    { label: t('common.nav.home'), url: `${url.origin}/` },
    { label: t('contact.title') },
]);

const seo = resolveSeo(url, {
    title: t('contact.title'),
    description: t('contact.meta_description'),
    type: 'website',
});

const phoneHref = settings.phoneHref();
const emergencyHref = settings.emergencyPhoneHref();
const address = settings.fullAddress();
const serviceEntries = Object.entries(serviceTypes);
---
<Base resolved={seo} schema={schema}>
    <PageHeader title={t('contact.heading')} subtitle={t('contact.subheading')} breadcrumbs={breadcrumbs} />

    <section class="section-spacing">
        <div class="container-page">
            <div class="grid gap-10 lg:grid-cols-5">
                <div class="lg:col-span-3">
                    <Card padding="lg">
                        <h2 class="text-xl font-bold text-neutral-900">{t('contact.form.heading')}</h2>
                        <p class="mt-1 text-sm text-neutral-500">{t('contact.form.required_note')}</p>

                        <form
                            method="POST"
                            name="contact"
                            data-netlify="true"
                            netlify-honeypot="bot-field"
                            class="mt-6 space-y-5"
                            x-data={`
                                contactForm({
                                    maxMessage: 5000,
                                    messages: {
                                        nameRequired: ${JSON.stringify(t('contact.validation.name_required'))},
                                        nameMin: ${JSON.stringify(t('contact.validation.name_min'))},
                                        emailRequired: ${JSON.stringify(t('contact.validation.email_required'))},
                                        emailInvalid: ${JSON.stringify(t('contact.validation.email_invalid'))},
                                        phoneInvalid: ${JSON.stringify(t('contact.validation.phone_invalid'))},
                                        serviceRequired: ${JSON.stringify(t('contact.validation.service_required'))},
                                        messageRequired: ${JSON.stringify(t('contact.validation.message_required'))},
                                        messageMin: ${JSON.stringify(t('contact.validation.message_min'))},
                                        consentRequired: ${JSON.stringify(t('contact.validation.consent_required'))}
                                    }
                                })
                            `}
                            x-on:submit="onSubmit($event)"
                            novalidate
                        >
                            <input type="hidden" name="form-name" value="contact" />

                            <div class="absolute left-[-9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
                                <label for="bot-field">Leave this field empty</label>
                                <input type="text" id="bot-field" name="bot-field" tabindex="-1" autocomplete="off" value="">
                            </div>

                            <div class="grid gap-5 sm:grid-cols-2">
                                <div class="w-full">
                                    <label for="name" class="block text-sm font-medium text-neutral-900">
                                        {t('contact.fields.name')}<span class="text-danger-600" aria-hidden="true">*</span><span class="sr-only">(required)</span>
                                    </label>
                                    <input
                                        type="text"
                                        id="name"
                                        name="name"
                                        placeholder={t('contact.fields.name_placeholder')}
                                        autocomplete="name"
                                        maxlength="120"
                                        required
                                        :aria-invalid="touched.name && errors.name ? 'true' : undefined"
                                        :aria-describedby="touched.name && errors.name ? 'name-error' : undefined"
                                        x-on:blur="markTouched('name'); validateField('name', $event.target.value)"
                                        x-on:input="touched.name && validateField('name', $event.target.value)"
                                        class="mt-1.5 block w-full min-h-touch rounded-md border px-3 py-2.5 text-base shadow-sm transition-colors placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-offset-0 border-neutral-300 text-neutral-900 focus:border-primary-600 focus:ring-primary-500"
                                    />
                                    <p id="name-error" x-show="touched.name && errors.name" x-text="errors.name" class="mt-1.5 text-sm font-medium text-danger-700"></p>
                                </div>

                                <div class="w-full">
                                    <label for="email" class="block text-sm font-medium text-neutral-900">
                                        {t('contact.fields.email')}<span class="text-danger-600" aria-hidden="true">*</span><span class="sr-only">(required)</span>
                                    </label>
                                    <input
                                        type="email"
                                        id="email"
                                        name="email"
                                        placeholder={t('contact.fields.email_placeholder')}
                                        autocomplete="email"
                                        inputmode="email"
                                        maxlength="180"
                                        required
                                        :aria-invalid="touched.email && errors.email ? 'true' : undefined"
                                        :aria-describedby="touched.email && errors.email ? 'email-error' : undefined"
                                        x-on:blur="markTouched('email'); validateField('email', $event.target.value)"
                                        x-on:input="touched.email && validateField('email', $event.target.value)"
                                        class="mt-1.5 block w-full min-h-touch rounded-md border px-3 py-2.5 text-base shadow-sm transition-colors placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-offset-0 border-neutral-300 text-neutral-900 focus:border-primary-600 focus:ring-primary-500"
                                    />
                                    <p id="email-error" x-show="touched.email && errors.email" x-text="errors.email" class="mt-1.5 text-sm font-medium text-danger-700"></p>
                                </div>
                            </div>

                            <div class="grid gap-5 sm:grid-cols-2">
                                <div class="w-full">
                                    <label for="phone" class="block text-sm font-medium text-neutral-900">{t('contact.fields.phone')}</label>
                                    <input
                                        type="tel"
                                        id="phone"
                                        name="phone"
                                        placeholder={t('contact.fields.phone_placeholder')}
                                        autocomplete="tel"
                                        inputmode="tel"
                                        maxlength="32"
                                        :aria-invalid="touched.phone && errors.phone ? 'true' : undefined"
                                        :aria-describedby="touched.phone && errors.phone ? 'phone-error' : (touched.phone && errors.phone ? undefined : 'phone-help')"
                                        x-on:blur="markTouched('phone'); validateField('phone', $event.target.value)"
                                        x-on:input="touched.phone && validateField('phone', $event.target.value)"
                                        class="mt-1.5 block w-full min-h-touch rounded-md border px-3 py-2.5 text-base shadow-sm transition-colors placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-offset-0 border-neutral-300 text-neutral-900 focus:border-primary-600 focus:ring-primary-500"
                                    />
                                    <p id="phone-help" class="mt-1.5 text-sm text-neutral-500">{t('contact.fields.phone_help')}</p>
                                    <p id="phone-error" x-show="touched.phone && errors.phone" x-text="errors.phone" class="mt-1.5 text-sm font-medium text-danger-700"></p>
                                </div>

                                <div class="w-full">
                                    <label for="service_type" class="block text-sm font-medium text-neutral-900">
                                        {t('contact.fields.service_type')}<span class="text-danger-600" aria-hidden="true">*</span><span class="sr-only">(required)</span>
                                    </label>
                                    <select
                                        id="service_type"
                                        name="service_type"
                                        required
                                        x-init="$el.value = new URLSearchParams(window.location.search).get('service') || $el.value"
                                        :aria-invalid="touched.service_type && errors.service_type ? 'true' : undefined"
                                        :aria-describedby="touched.service_type && errors.service_type ? 'service_type-error' : undefined"
                                        x-on:change="markTouched('service_type'); validateField('service_type', $event.target.value)"
                                        class="mt-1.5 block w-full min-h-touch rounded-md border px-3 py-2.5 text-base shadow-sm transition-colors focus:outline-none focus:ring-2 border-neutral-300 text-neutral-900 focus:border-primary-600 focus:ring-primary-500"
                                    >
                                        <option value="">{t('contact.fields.service_placeholder')}</option>
                                        {
                                            serviceEntries.map(([value, label]) => (
                                                <option value={value}>{label}</option>
                                            ))
                                        }
                                    </select>
                                    <p id="service_type-error" x-show="touched.service_type && errors.service_type" x-text="errors.service_type" class="mt-1.5 text-sm font-medium text-danger-700"></p>
                                </div>
                            </div>

                            <div>
                                <label for="message" class="block text-sm font-medium text-neutral-900">
                                    {t('contact.fields.message')}<span class="text-danger-600" aria-hidden="true">*</span><span class="sr-only">(required)</span>
                                </label>
                                <textarea
                                    id="message"
                                    name="message"
                                    rows="6"
                                    maxlength="5000"
                                    required
                                    x-ref="message"
                                    :aria-invalid="touched.message && errors.message ? 'true' : undefined"
                                    :aria-describedby="touched.message && errors.message ? 'message-error' : (errors.message ? undefined : 'message-help')"
                                    x-on:input="onMessageInput($event)"
                                    x-on:blur="markTouched('message'); validateField('message', $event.target.value)"
                                    class="mt-1.5 block w-full rounded-md border px-3 py-2.5 text-base shadow-sm transition-colors placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-offset-0 border-neutral-300 text-neutral-900 focus:border-primary-600 focus:ring-primary-500"
                                    placeholder={t('contact.fields.message_placeholder')}
                                ></textarea>
                                <p id="message-help" class="mt-1.5 text-sm text-neutral-500">{t('contact.fields.message_help')}</p>
                                <p id="message-error" x-show="touched.message && errors.message" x-text="errors.message" class="mt-1.5 text-sm font-medium text-danger-700"></p>
                                <p class="mt-1 text-right text-xs text-neutral-500" aria-live="polite">
                                    <span x-text="remaining"></span> / 5,000
                                </p>
                            </div>

                            <div class="w-full">
                                <div class="flex items-start gap-3">
                                    <input
                                        type="checkbox"
                                        id="consent"
                                        name="consent"
                                        value="1"
                                        required
                                        :aria-invalid="touched.consent && errors.consent ? 'true' : undefined"
                                        :aria-describedby="touched.consent && errors.consent ? 'consent-error' : undefined"
                                        x-on:change="touched.consent = true; if ($event.target.checked) { delete errors.consent; } else { errors.consent = messages.consentRequired; }"
                                        class="mt-1 h-5 w-5 shrink-0 rounded border-2 border-neutral-300 text-primary-700 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-1"
                                    />
                                    <label for="consent" class="text-sm leading-relaxed text-neutral-700">
                                        {t('contact.fields.consent')}<span class="text-danger-600" aria-hidden="true">*</span><span class="sr-only">(required)</span>
                                    </label>
                                </div>
                                <p id="consent-error" x-show="touched.consent && errors.consent" x-text="errors.consent" class="mt-1.5 pl-8 text-sm font-medium text-danger-700"></p>
                                <p class="-mt-1 pl-8 text-sm text-neutral-500">
                                    <a href="/privacy-policy" class="text-primary-800 underline underline-offset-2">{t('contact.fields.consent_link')}</a>
                                </p>
                            </div>

                            <div class="pt-2">
                                <button
                                    type="submit"
                                    :disabled="submitting"
                                    :aria-busy="submitting ? 'true' : 'false'"
                                    class="relative inline-flex min-h-touch w-full items-center justify-center gap-2 rounded-md bg-primary-800 px-6 py-3 text-base font-semibold text-white shadow-sm transition-colors hover:bg-primary-900 active:bg-primary-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
                                >
                                    <span x-show="submitting" x-cloak class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-current border-r-transparent" aria-hidden="true"></span>
                                    <span x-text="submitting ? 'Sending…' : 'Send enquiry'">Send enquiry</span>
                                </button>
                            </div>
                        </form>
                    </Card>
                </div>

                <aside class="lg:col-span-2">
                    <Card padding="lg">
                        <h2 class="text-lg font-bold text-neutral-900">{t('contact.sidebar.heading')}</h2>
                        <dl class="mt-5 space-y-5 text-sm">
                            {
                                phoneHref && (
                                    <div class="flex items-start gap-3">
                                        <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                            <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.5 11.5 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-7.18 0-13-5.82-13-13V3.5Z" />
                                        </svg>
                                        <div>
                                            <dt class="font-semibold text-neutral-900">{t('contact.sidebar.phone_label')}</dt>
                                            <dd><a href={phoneHref} class="text-primary-800 hover:underline">{settings.phone}</a></dd>
                                        </div>
                                    </div>
                                )
                            }
                            {
                                emergencyHref && (
                                    <div class="flex items-start gap-3">
                                        <svg class="mt-0.5 h-5 w-5 shrink-0 text-danger-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                            <path d="M11.983 1.907a.75.75 0 0 0-1.292-.657l-6.5 8.5A.75.75 0 0 0 4.75 11h3.925l-.658 5.093a.75.75 0 0 0 1.292.657l6.5-8.5A.75.75 0 0 0 15.25 7h-3.925l.658-5.093Z" />
                                        </svg>
                                        <div>
                                            <dt class="font-semibold text-neutral-900">{t('contact.sidebar.emergency_label')}</dt>
                                            <dd><a href={emergencyHref} class="text-danger-700 hover:underline">{settings.emergencyPhone}</a></dd>
                                        </div>
                                    </div>
                                )
                            }
                            {
                                settings.email && (
                                    <div class="flex items-start gap-3">
                                        <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                            <path d="M3 4a2 2 0 0 0-2 2v.161l8.441 4.221a1.25 1.25 0 0 0 1.118 0L19 6.161V6a2 2 0 0 0-2-2H3Z" />
                                            <path d="m19 8.839-7.77 3.885a2.75 2.75 0 0 1-2.46 0L1 8.839V14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.839Z" />
                                        </svg>
                                        <div class="min-w-0">
                                            <dt class="font-semibold text-neutral-900">{t('contact.sidebar.email_label')}</dt>
                                            <dd><a href={`mailto:${settings.email}`} class="break-all text-primary-800 hover:underline">{settings.email}</a></dd>
                                        </div>
                                    </div>
                                )
                            }
                            {
                                address && (
                                    <div class="flex items-start gap-3">
                                        <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                            <path fill-rule="evenodd" d="M9.69 18.933A7.5 7.5 0 0 0 10 19a7.5 7.5 0 0 0 .31-.067C13.02 17.79 16 14.2 16 10a6 6 0 1 0-12 0c0 4.2 2.98 7.79 5.69 8.933ZM10 11.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z" clip-rule="evenodd" />
                                        </svg>
                                        <div>
                                            <dt class="font-semibold text-neutral-900">{t('contact.sidebar.address_label')}</dt>
                                            <dd><address class="not-italic text-neutral-600">{address}</address></dd>
                                        </div>
                                    </div>
                                )
                            }
                            {
                                settings.hasBusinessHours() && (
                                    <div class="flex items-start gap-3">
                                        <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z" clip-rule="evenodd" />
                                        </svg>
                                        <div class="min-w-0 flex-1">
                                            <dt class="font-semibold text-neutral-900">{t('contact.sidebar.hours_label')}</dt>
                                            <dd class="mt-1 space-y-0.5 text-neutral-600">
                                                {
                                                    settings.businessHours.map((row) => (
                                                        <div class="flex justify-between gap-3">
                                                            <span>{row.day}</span>
                                                            <span class="text-right">{row.hours}</span>
                                                        </div>
                                                    ))
                                                }
                                            </dd>
                                        </div>
                                    </div>
                                )
                            }
                        </dl>
                    </Card>

                    {
                        settings.mapEmbedUrl && (
                            <div class="mt-6 overflow-hidden rounded-lg border border-neutral-200">
                                <iframe
                                    src={settings.mapEmbedUrl}
                                    title={t('contact.sidebar.map_title')}
                                    width="100%"
                                    height="320"
                                    style="border:0"
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"
                                    allowfullscreen
                                ></iframe>
                            </div>
                        )
                    }
                </aside>
            </div>
        </div>
    </section>
</Base>
