---
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';
import { staticPages, teamMembers, type TeamMember } from '../lib/content';
import { renderMarkdown } from '../lib/markdown';
import { resolveSeo, breadcrumbSchema, organizationSchema } from '../lib/seo';
import PageHeader from '../components/sections/PageHeader.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Card from '../components/ui/Card.astro';
import Media from '../components/ui/Media.astro';
import Badge from '../components/ui/Badge.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';

const url = Astro.url;
const page = staticPages().find((p) => p.slug === 'about');
const team = teamMembers();
const { html: bodyHtml } = await renderMarkdown(page?.body ?? '', 'about page');

const certifications = team
    .flatMap((m) => m.certifications)
    .filter((cert, index, arr) => arr.findIndex((c) => c.name === cert.name && (c.issuer ?? '') === (cert.issuer ?? '')) === index);

const breadcrumbs = [
    { label: t('common.nav.home'), url: '/' },
    { label: page?.title ?? t('about.heading') },
];

const schema = [
    organizationSchema(),
    breadcrumbSchema([
        { label: t('common.nav.home'), url: `${url.origin}/` },
        { label: page?.title ?? t('about.heading') },
    ]),
];

const seo = resolveSeo(url, {
    title: page?.title ?? t('about.heading'),
    description: page?.metaDescription ?? t('about.meta_description'),
    image: page?.featuredImage,
    type: 'website',
});
---
<Base resolved={seo} schema={schema}>
    <PageHeader title={page?.title ?? t('about.heading')} breadcrumbs={breadcrumbs} />

    <section class="section-spacing">
        <div class="container-page">
            {
                bodyHtml !== '' ? (
                    <div class="prose prose-neutral mx-auto max-w-prose" set:html={bodyHtml} />
                ) : (
                    <EmptyState message={t('about.story_missing')} actionLabel={t('common.cta.contact_us')} actionHref="/contact" />
                )
            }
        </div>
    </section>

    <section class="section-spacing bg-neutral-50" aria-labelledby="team-heading">
        <div class="container-page">
            <SectionHeading id="team-heading" title={t('about.team.heading')} subtitle={t('about.team.subheading')} />

            {
                team.length === 0 ? (
                    <div class="mt-10"><EmptyState message={t('about.team.empty')} /></div>
                ) : (
                    <ul role="list" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                        {
                            team.map((member) => (
                                <li class="h-full">
                                    <Card as="article" class="flex h-full flex-col text-center" padding="md">
                                        {
                                            member.photo ? (
                                                <Media src={member.photo} alt={t('about.team.photo_alt', { name: member.name })} width={160} height={160} class="mx-auto h-24 w-24 rounded-full object-cover" />
                                            ) : (
                                                <span class="mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-primary-100 text-xl font-semibold text-primary-800" aria-hidden="true">
                                                    {member.initials()}
                                                </span>
                                            )
                                        }
                                        <h3 class="mt-4 text-base font-semibold text-neutral-900">{member.name}</h3>
                                        <p class="text-sm text-primary-800">{member.role}</p>
                                        {
                                            member.bio && <p class="mt-3 flex-1 text-sm leading-relaxed text-neutral-600">{member.bio.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim().slice(0, 160)}</p>
                                        }
                                        {
                                            member.certifications.length > 0 && (
                                                <ul role="list" class="mt-4 flex flex-wrap justify-center gap-1.5">
                                                    {
                                                        member.certifications.map((cert) => (
                                                            <li><Badge variant="neutral" size="sm">{cert.name}</Badge></li>
                                                        ))
                                                    }
                                                </ul>
                                            )
                                        }
                                        {
                                            member.email && (
                                                <a href={`mailto:${member.email}`} class="mt-4 inline-flex min-h-touch items-center justify-center text-sm font-medium text-primary-800 hover:underline">
                                                    <span class="sr-only">{t('about.team.email_label', { name: member.name })}</span>
                                                    <span aria-hidden="true">{member.email}</span>
                                                </a>
                                            )
                                        }
                                    </Card>
                                </li>
                            ))
                        }
                    </ul>
                )
            }
        </div>
    </section>

    <section class="section-spacing" aria-labelledby="certifications-heading">
        <div class="container-page">
            <SectionHeading id="certifications-heading" title={t('about.certifications.heading')} subtitle={t('about.certifications.subheading')} />

            {
                certifications.length === 0 ? (
                    <div class="mt-10"><EmptyState message={t('about.certifications.empty')} icon={false} /></div>
                ) : (
                    <ul role="list" class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-2">
                        {
                            certifications.map((cert) => (
                                <li>
                                    <Card padding="sm" class="flex items-start gap-3">
                                        <svg class="mt-0.5 h-5 w-5 shrink-0 text-success-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                            <path fill-rule="evenodd" d="M16.403 12.652a3 3 0 0 0 0-5.304 3 3 0 0 0-3.75-3.751 3 3 0 0 0-5.305 0 3 3 0 0 0-3.751 3.75 3 3 0 0 0 0 5.305 3 3 0 0 0 3.75 3.751 3 3 0 0 0 5.305 0 3 3 0 0 0 3.751-3.75Zm-2.546-4.46a.75.75 0 0 0-1.214-.883l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                                        </svg>
                                        <div>
                                            <p class="text-sm font-semibold text-neutral-900">{cert.name}</p>
                                            {
                                                (cert.issuer || cert.year) && (
                                                    <p class="text-sm text-neutral-500">
                                                        {[cert.issuer, cert.year].filter((v) => v !== undefined && v !== '').join(' · ')}
                                                    </p>
                                                )
                                            }
                                        </div>
                                    </Card>
                                </li>
                            ))
                        }
                    </ul>
                )
            }
        </div>
    </section>

    <CtaBanner
        heading={t('home.cta.heading')}
        body={t('home.cta.body')}
        buttonLabel={t('home.cta.button')}
        buttonHref="/contact"
    />
</Base>
