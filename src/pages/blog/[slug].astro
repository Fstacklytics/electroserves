---
import Base from '../../layouts/Base.astro';
import { t } from '../../lib/i18n';
import { blogPosts, getBlogPost, hasMediaSrc } from '../../lib/content';
import { renderMarkdown } from '../../lib/markdown';
import { resolveSeo, breadcrumbSchema, organizationSchema } from '../../lib/seo';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import Badge from '../../components/ui/Badge.astro';
import Media from '../../components/ui/Media.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import BlogCard from '../../components/sections/BlogCard.astro';
import Social from '../../components/icons/Social.astro';

export async function getStaticPaths() {
    return blogPosts().map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug ?? '');
const url = Astro.url;

if (!post) {
    return Astro.redirect('/404');
}

const { html: bodyHtml, headings } = await renderMarkdown(post.body, `blog post ${post.slug}`);
const allPosts = blogPosts();
const relatedPosts = allPosts.filter((p) => p.slug !== post.slug && p.category === post.category).slice(0, 3);

const shareUrl = `${url.origin}${url.pathname}`;
const shareTitle = encodeURIComponent(post.title);

const breadcrumbs = [
    { label: t('common.nav.home'), url: '/' },
    { label: t('blog.index.title'), url: '/blog' },
    { label: post.title },
];

const schema = [
    organizationSchema(),
    breadcrumbSchema([
        { label: t('common.nav.home'), url: `${url.origin}/` },
        { label: t('blog.index.title'), url: `${url.origin}/blog` },
        { label: post.title },
    ]),
];

const seo = resolveSeo(url, {
    title: post.title,
    description: post.metaDescription ?? post.excerpt,
    image: post.featuredImage,
    type: 'article',
});
---
<Base resolved={seo} schema={schema}>
    <div class="border-b border-neutral-200 bg-neutral-50">
        <div class="container-page">
            <Breadcrumb crumbs={breadcrumbs} />
        </div>
    </div>

    <article class="section-spacing">
        <div class="container-page">
            <header class="mx-auto max-w-3xl">
                <Badge variant="secondary">{post.category}</Badge>
                <h1 class="mt-3 text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">{post.title}</h1>
                <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-neutral-500">
                    <span>{t('blog.show.by_author', { author: post.author })}</span>
                    {
                        post.date && (
                            <>
                                <span aria-hidden="true">·</span>
                                <time datetime={post.dateIso() ?? undefined}>{post.formattedDate()}</time>
                            </>
                        )
                    }
                    <span aria-hidden="true">·</span>
                    <span>{t('blog.show.reading_time', { minutes: post.readingTimeMinutes() })}</span>
                </p>
            </header>

            {
                hasMediaSrc(post.featuredImage) && (
                    <div class="mx-auto mt-8 max-w-4xl">
                        <Media src={post.featuredImage} alt={post.title} width={1280} height={720} eager class="aspect-[16/9] w-full rounded-lg object-cover shadow-md" />
                    </div>
                )
            }

            <div class="mt-10 grid gap-10 lg:grid-cols-4">
                {
                    headings.length > 0 && (
                        <aside class="lg:col-span-1 lg:order-2" aria-labelledby="toc-heading">
                            <nav class="lg:sticky lg:top-28">
                                <p id="toc-heading" class="text-sm font-semibold text-neutral-900">{t('blog.show.contents')}</p>
                                <ol class="mt-3 space-y-1 border-l border-neutral-200 text-sm">
                                    {
                                        headings.map((heading) => (
                                            <li>
                                                <a
                                                    href={`#${heading.id}`}
                                                    class:list={[
                                                        'block border-l-2 border-transparent py-1.5 pl-3 -ml-px text-neutral-600 hover:border-primary-600 hover:text-primary-800',
                                                        heading.level === 3 && 'pl-6',
                                                    ]}
                                                >{heading.text}</a>
                                            </li>
                                        ))
                                    }
                                </ol>
                            </nav>
                        </aside>
                    )
                }

                <div class:list={['lg:order-1', headings.length > 0 ? 'lg:col-span-3' : 'lg:col-span-4']}>
                    <div class="mx-auto max-w-prose">
                        {
                            bodyHtml !== '' ? (
                                <div class="prose prose-neutral max-w-none" set:html={bodyHtml} />
                            ) : (
                                <EmptyState message={t('blog.show.no_body')} icon={false} />
                            )
                        }

                        {
                            post.hasTags() && (
                                <div class="mt-8">
                                    <h2 class="text-sm font-semibold text-neutral-900">{t('blog.show.tags')}</h2>
                                    <ul role="list" class="mt-2 flex flex-wrap gap-2">
                                        {
                                            post.tags.map((tag) => (
                                                <li><span class="inline-flex items-center gap-1 rounded-full bg-neutral-100 px-2.5 py-1 text-xs font-medium text-neutral-700">#{tag}</span></li>
                                            ))
                                        }
                                    </ul>
                                </div>
                            )
                        }

                        <div
                            class="mt-8 border-t border-neutral-200 pt-6"
                            x-data={`copyLink({ url: ${JSON.stringify(shareUrl)}, copiedLabel: ${JSON.stringify(t('blog.show.link_copied'))}, failedLabel: ${JSON.stringify(t('blog.show.copy_failed'))} })`}
                        >
                            <h2 class="text-sm font-semibold text-neutral-900">{t('blog.show.share')}</h2>

                            <div class="mt-3 flex flex-wrap items-center gap-2">
                                <a
                                    href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${shareTitle}`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="touch-target rounded-md border border-neutral-300 px-3 text-sm text-neutral-700 hover:bg-neutral-100"
                                >
                                    <span class="sr-only">{t('blog.show.share_twitter')}</span>
                                    <Social network="twitter" class="h-4 w-4" />
                                </a>

                                <a
                                    href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="touch-target rounded-md border border-neutral-300 px-3 text-sm text-neutral-700 hover:bg-neutral-100"
                                >
                                    <span class="sr-only">{t('blog.show.share_facebook')}</span>
                                    <Social network="facebook" class="h-4 w-4" />
                                </a>

                                <a
                                    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="touch-target rounded-md border border-neutral-300 px-3 text-sm text-neutral-700 hover:bg-neutral-100"
                                >
                                    <span class="sr-only">{t('blog.show.share_linkedin')}</span>
                                    <Social network="linkedin" class="h-4 w-4" />
                                </a>

                                <button
                                    type="button"
                                    data-js-only
                                    x-on:click="copy()"
                                    :aria-busy="status === 'loading' ? 'true' : 'false'"
                                    class="inline-flex min-h-touch items-center gap-2 rounded-md border border-neutral-300 px-3 text-sm font-medium text-neutral-700 hover:bg-neutral-100"
                                >
                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" focusable="false">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
                                    </svg>
                                    {t('blog.show.copy_link')}
                                </button>

                                <span
                                    x-show="message !== ''"
                                    x-cloak
                                    x-text="message"
                                    :class="status === 'error' ? 'text-danger-700' : 'text-success-700'"
                                    class="text-sm font-medium"
                                    role="status"
                                ></span>
                            </div>
                        </div>

                        <div class="mt-8">
                            <a href="/blog" class="inline-flex min-h-touch items-center text-sm font-semibold text-primary-800 hover:underline">
                                &larr; {t('blog.show.back_to_blog')}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </article>

    {
        relatedPosts.length > 0 && (
            <section class="section-spacing bg-neutral-50" aria-labelledby="related-posts-heading">
                <div class="container-page">
                    <h2 id="related-posts-heading" class="text-2xl font-bold tracking-tight text-neutral-900">{t('blog.show.related')}</h2>
                    <ul role="list" class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                        {
                            relatedPosts.map((related) => (
                                <li class="h-full"><BlogCard post={related} /></li>
                            ))
                        }
                    </ul>
                </div>
            </section>
        )
    }
</Base>
